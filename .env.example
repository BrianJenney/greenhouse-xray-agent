# ---------------------------------------------------------------------------
# 1. LLM access — the Parsity LiteLLM proxy (key handed out in class)
# ---------------------------------------------------------------------------
# The AI SDK's openai provider reads BOTH of these from the environment on its
# own, so there is no client wiring anywhere in the code.
#
# Use UNPREFIXED model aliases. Everything under openai/* on this proxy is a
# wildcard passthrough and returns "invalid model ID".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://parsity-litellm.fly.dev/v1

# ---------------------------------------------------------------------------
# 2. Google search — Serper (free, no card, takes about a minute)
# ---------------------------------------------------------------------------
#   1. Go to https://serper.dev and sign up with Google or email
#   2. The dashboard shows your API key on the first screen
#   3. Paste it below
#
# Free tier is 2,500 credits. One search = 1 credit, and one job search here
# runs up to 5 of them, so that is ~500 searches.
#
# Why a key at all: DuckDuckGo's HTML endpoint blocks after a handful of
# requests and Mojeek serves a captcha, and Greenhouse itself has no
# cross-board search API. See the README.
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# 3. Tracing — LangSmith (optional; everything works without it)
# ---------------------------------------------------------------------------
#   1. Sign up at https://smith.langchain.com
#   2. Settings > API Keys > Create API Key
#
# With LANGSMITH_TRACING=true, every model call in the process is traced from a
# single registerTelemetry() in lib/tracing.ts — both agents and the eval judge.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=greenhouse-xray
