# ---------------------------------------------------------------------------
# 1. LLM access — the Parsity LiteLLM proxy (key handed out in class)
# ---------------------------------------------------------------------------
# The AI SDK's openai provider reads BOTH of these from the environment on its
# own, so there is no client wiring anywhere in the code.
#
# Use UNPREFIXED model aliases. Everything under openai/* on this proxy is a
# wildcard passthrough and returns "invalid model ID".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://parsity-litellm.fly.dev/v1

# ---------------------------------------------------------------------------
# 2. Search — nothing to set up
# ---------------------------------------------------------------------------
# Searching is keyless: queries go to Brave and postings are read back from the
# public Greenhouse board API. Brave rate-limits to roughly one search per 30
# seconds per IP, so on shared wifi you will take turns.
#
# 3. Tracing — LangSmith (add these live, in class)
# ---------------------------------------------------------------------------
# Everything below is already wired. Filling these in is the only step.
#
#   1. Sign up at https://smith.langchain.com
#   2. Settings > API Keys > Create API Key
#   3. Set LANGSMITH_TRACING=true and paste the key
#
# LANGSMITH_ENDPOINT is required — without it the client has nowhere to send.
#
# One registerTelemetry() in lib/tracing.ts covers every model call in the
# process: both agents and the eval judge. Scripts also call flushTracing(),
# because traces are batched and a short-lived process exits before the batch
# goes out — which looks exactly like tracing being broken.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=greenhouse-xray
