# ---------------------------------------------------------------------------
# 1. LLM access — the Parsity LiteLLM proxy (key handed out in class)
# ---------------------------------------------------------------------------
# The AI SDK's openai provider reads BOTH of these from the environment on its
# own, so there is no client wiring anywhere in the code.
#
# Use UNPREFIXED model aliases. Everything under openai/* on this proxy is a
# wildcard passthrough and returns "invalid model ID".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://parsity-litellm.fly.dev/v1

# ---------------------------------------------------------------------------
# 2. Search + scrape — Firecrawl (free key, no card)
# ---------------------------------------------------------------------------
#   1. https://firecrawl.dev -> sign up
#   2. Dashboard -> API Keys -> copy
#
# One call searches Google (scoped to boards.greenhouse.io) and returns every
# result's page already cleaned to markdown.
#
# Free tier: 500 credits and 10 REQUESTS PER MINUTE. Each query is one request,
# so a 4-query search uses 4 of your 10 — about two searches a minute per key.
# Everyone in the room needs their own key.
FIRECRAWL_API_KEY=

# 3. Tracing — LangSmith (add these live, in class)
# ---------------------------------------------------------------------------
# Everything is already wired. Filling these in is the only step.
#
#   1. Sign up at https://smith.langchain.com
#   2. Settings > API Keys > Create API Key
#   3. Set LANGSMITH_TRACING=true and paste the key
#
# LANGSMITH_ENDPOINT is required — without it the client has nowhere to send.
# Scripts call flushTracing() because traces are batched and a short-lived
# process exits before the batch goes out — which looks exactly like tracing
# being broken.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=greenhouse-xray
